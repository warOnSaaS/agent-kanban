{
  "name": "agent-kanban",
  "type": "module",
  "description": "A shared kanban for people and their AI agents: tasks, hand-offs and reviews in a GitHub repo, reachable from Claude, ChatGPT, Claude Code and Codex over MCP.",
  "scripts": {
    "dev": "node dev.mjs",
    "test": "node --test test/",
    "check:clean": "node scripts/check-clean.mjs",
    "check": "node --test test/ && node scripts/check-clean.mjs",
    "invite": "node scripts/invite.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/warOnSaaS/agent-kanban"
  }
}
